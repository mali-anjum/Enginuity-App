# =============================================================================
# Enginuity — environment variables (Expo public client config)
# =============================================================================
#
# MVP (recommended): copy this file once and fill it:
#   cp .env.example .env
# Then run: yarn start
# Expo loads `.env` automatically — no extra flags.
#
# Later (multiple backends): copy sections into named files Git already ignores:
#   .env.development   → yarn start:dev
#   .env.staging       → yarn start:staging
#   .env.production    → yarn start:prod   (local smoke tests only; real releases
#                         should use EAS/CI secrets, not a committed file)
#
# Keys are read from src/sharedModules/utils/env.ts (EXPO_PUBLIC_*).
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
