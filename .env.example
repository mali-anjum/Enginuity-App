# =============================================================================
# Enginuity — environment variables (Expo public client config)
# =============================================================================
#
# Development (daily work — file is gitignored):
#   cp .env.example .env.local
# Fill with your **dev** Supabase project, then:
#   yarn start
#
# Scripts load `.env.local` via dotenv-cli (`package.json`). Missing keys use
# fallbacks listed in src/sharedModules/utils/env.ts (`EXPO_PUBLIC_*`).
#
# Production / prod smoke-tests (gitignored):
#   cp .env.example .env.production
#   yarn start:prod
#
# Optional (same keys, different Supabase project):
#   cp .env.example .env.staging     → yarn start:staging
#   cp .env.example .env.development → yarn start:dev
#
# Ship builds: inject EXPO_PUBLIC_* via EAS / CI secrets—not committed .env files.
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional aliases (same values; kept for tooling that expects NEXT_PUBLIC_*)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
