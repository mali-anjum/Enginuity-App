# =============================================================================
# Enginuity — environment variables (Expo public client config)
# =============================================================================
#
# Use TWO Supabase projects for dev vs prod when you want separate data/users.
# Copy this file separately for each backend and paste URL + publishable key
# from THAT project only (Project Settings → General + API Keys).
#
# ── Development / daily work → copy to `.env.local` ─────────────────────────
#   cp .env.example .env.local
#   yarn start    (loads .env.local via dotenv-cli)
#
# ── Production smoke-tests locally → copy to `.env.production` ───────────────
#   cp .env.example .env.production
#   yarn start:prod
#
# Same variable names everywhere; values differ per Supabase project.
#
# Optional: copy to `.env.staging` → yarn start:staging,
#           or `.env.development` → yarn start:dev.
#
# Ship builds: inject EXPO_PUBLIC_* via EAS / CI—not committed env files.
# -----------------------------------------------------------------------------
# Replace placeholders below with ONE project’s URL + publishable key.
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional aliases for tooling that expects NEXT_PUBLIC_* (same values as above)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
